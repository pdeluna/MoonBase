<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permanent debug-harness support for MOONBASE_BLACKHOLE; not throwaway.
         Debug-only cleartext exemption for the MOONBASE_BLACKHOLE sink
         (192.0.2.1 only; see res/xml/network_security_config.xml). The main
         manifest declares no networkSecurityConfig, so release is unaffected. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
